{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "url-shortener",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "build": { "command": "npm run build" },
  "vars": { "SESSION_TTL_HOURS": "24", "STORAGE_PROFILE": "durable-objects" },
  "durable_objects": { "bindings": [{ "name": "WORKSPACES", "class_name": "ShortenerWorkspace" }, { "name": "SHORT_LINKS", "class_name": "ShortLink" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShortenerWorkspace", "ShortLink"] }],
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "13002", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true }
}
